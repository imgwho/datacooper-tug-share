{
  "name": "20260513-datacooper-tug-share",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "slidev slides.md --open",
    "dev:en": "slidev slides-en.md --open",
    "build": "pnpm build:cn && pnpm build:en",
    "build:cn": "slidev build slides.md --out dist --base /datacooper-tug-share/",
    "build:en": "slidev build slides-en.md --out dist/en --base /datacooper-tug-share/en/",
    "preview:build": "pnpm preview:build:cn && pnpm preview:build:en",
    "preview:build:cn": "slidev build slides.md --out dist-local --base /",
    "preview:build:en": "slidev build slides-en.md --out dist-local/en --base /en/",
    "preview": "npx serve dist-local",
    "export": "slidev export"
  },
  "dependencies": {
    "@slidev/cli": "^52.8.0",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "latest",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "playwright-chromium": "^1.60.0"
  }
}
